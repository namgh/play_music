{
  "name": "studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:dsp && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "instruments:index": "node --experimental-strip-types tools/build-instrument-index.mjs",
    "instruments:check": "node --experimental-strip-types tools/build-instrument-index.mjs --check",
    "m0": "node spike/m0-karplus/serve.mjs",
    "test:pitch": "node spike/m0-karplus/test-pitch.mjs",
    "test:model": "node --test 'src/**/*.test.ts'",
    "test:perf": "node --test --test-concurrency=1 src/audio/cpuBudget.perf.ts",
    "test": "npm run build:dsp && npm run test:model && npm run test:perf && npm run test:pitch",
    "build:dsp": "$HOME/.cargo/bin/cargo build --release --manifest-path dsp/Cargo.toml --target wasm32-unknown-unknown && cp dsp/target/wasm32-unknown-unknown/release/dsp.wasm src/generated/dsp.wasm",
    "test:dsp": "$HOME/.cargo/bin/cargo test --manifest-path dsp/Cargo.toml",
    "lint:dsp": "$HOME/.cargo/bin/cargo fmt --manifest-path dsp/Cargo.toml --check && $HOME/.cargo/bin/cargo clippy --manifest-path dsp/Cargo.toml --all-targets -- -D warnings",
    "check": "npm run instruments:check && npm run lint:dsp && npm run test:dsp && npm run build:dsp && npm run typecheck && npm run test:model && npm run test:perf && npm run test:pitch && npm run quality:smoke && vite build && npm run check:server",
    "check:browser": "node tools/browser-check.mjs",
    "check:server": "cd server && .venv/bin/ruff check src tests && .venv/bin/python -m pytest -q --timeout=120",
    "quality": "node --experimental-strip-types tools/quality-report.mjs",
    "quality:smoke": "node --experimental-strip-types tools/quality-report.mjs > /dev/null",
    "quality:compare": "node --experimental-strip-types tools/quality-compare.mjs",
    "test:quality": "node --experimental-strip-types --test 'src/audio/quality.test.ts'",
    "quality:sweep": "node --experimental-strip-types tools/quality-sweep.mjs",
    "demo": "node --experimental-strip-types tools/demo-songs.mjs",
    "demo:80s": "node --experimental-strip-types tools/song-billiejean.mjs",
    "levels": "node --experimental-strip-types tools/levels.mjs",
    "lowend": "node --experimental-strip-types tools/lowend.mjs",
    "partials": "node --experimental-strip-types tools/partials.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
