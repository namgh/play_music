# 시크릿을 어느 디렉터리에서도 커밋하지 않는다. server/.gitignore 한 줄에만
# 의존하면 다른 곳에 만든 .env 가 그대로 들어간다 — 커밋된 시크릿은
# 회전 말고는 되돌릴 방법이 없다
.env
.env.*
!.env.example

# node
node_modules/
dist/
*.log

# rust / wasm (M1 이후)
target/
pkg/

# 로컬 도구 상태
.impeccable/hook.cache.json
.impeccable/config.local.json
.impeccable/questions/
.claude/settings.local.json

# macOS
.DS_Store

# Rust 빌드 산출물을 복사한 것 — npm run build:dsp 로 다시 만든다
src/generated/

# 데모 곡·음질 측정 산출물 — WAV 는 수십 MB 라 저장소에 넣지 않는다
# (`npm run demo` 로 언제든 다시 만든다)
out/
