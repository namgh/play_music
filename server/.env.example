# `SERVER_OPS.md` 1절 — 설정은 전부 환경변수. 이 파일만 커밋한다
ENV=local
KEY_PREFIX=local:v1

DATABASE_URL=postgresql+asyncpg://resona:resona@localhost:5432/resona
# **캐시와 코어를 나눈다** — 축출 정책이 다르다 (SERVER_REDIS.md 2절)
REDIS_CACHE_URL=redis://localhost:6379/0
REDIS_CORE_URL=redis://localhost:6379/1

JWT_SECRET=change-me-in-production

STORAGE_BUCKET=resona-local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
