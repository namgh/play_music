# `SERVER_OPS.md` 1절 — 설정은 전부 환경변수. 이 파일만 커밋한다
ENV=local
KEY_PREFIX=local:v1

DATABASE_URL=postgresql+asyncpg://resona:resona@localhost:5432/resona
# **캐시와 코어를 나눈다** — 축출 정책이 다르다 (SERVER_REDIS.md 2절)
REDIS_CACHE_URL=redis://localhost:6379/0
REDIS_CORE_URL=redis://localhost:6379/1

JWT_SECRET=change-me-in-production

STORAGE_BUCKET=resona-local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- 오브젝트 스토리지 자격증명 (없으면 서명 URL 이 더미로 나간다) ---
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- 메일 (Gmail SMTP) ---------------------------------------------------
# **앱 비밀번호를 쓴다.** 계정 비밀번호는 동작하지 않는다 —
# 구글 계정 → 보안 → 2단계 인증(필수) → 앱 비밀번호에서 16자리를 발급받는다.
# 비어 있으면 메일은 큐에 그대로 쌓이고 발송만 안 된다 (로컬 개발용 동작).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=RESONA
# 메일 안의 링크가 가리킬 주소
APP_BASE_URL=http://localhost:5173

# --- 결제 웹훅 -----------------------------------------------------------
# 비어 있으면 서명 검증을 건너뛴다. **운영에서는 반드시 채운다** —
# 웹훅 URL 은 공개 주소라, 검증이 없으면 누구나 자기 계정을 Pro 로 만들 수 있다
BILLING_WEBHOOK_SECRET=
