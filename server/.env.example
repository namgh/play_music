# `SERVER_OPS.md` 1절 — 설정은 전부 환경변수. **이 파일만 커밋한다.**
#
# 여기 있는 키는 전부 `app/config.py` 의 `Settings` 필드와 1:1 이다.
# `Settings` 는 `extra="forbid"` 라 모르는 키가 하나라도 있으면 **부팅이 실패한다** —
# `tests/test_config.py` 가 그 대응을 검사한다. 한때 갈라져 있어서, 문서대로
# `cp .env.example .env` 하면 서버가 안 뜨고, 반대로 시크릿을 채워도 코드가
# `os.environ` 을 직접 읽느라 못 보던 상태였다.
#
# 로컬:  cp .env.example .env  →  그대로 돈다
# 운영:  시크릿을 채워야 한다. 비어 있으면 **부팅이 거부된다** (같은 파일 참고)

ENV=local
# 스테이징과 운영이 같은 Redis 를 보는 사고를 접두어로 막는다 (SERVER_REDIS.md 3절).
# 운영에서는 반드시 'production:' 으로 시작해야 한다
KEY_PREFIX=local:v1

# 포트는 docker-compose.yml 의 매핑과 맞춘다 (55432 / 56379)
DATABASE_URL=postgresql+asyncpg://resona:resona@localhost:55432/resona
# **캐시와 코어를 나눈다** — 축출 정책이 다르다 (SERVER_REDIS.md 2절)
REDIS_CACHE_URL=redis://localhost:56379/0
REDIS_CORE_URL=redis://localhost:56379/1

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# 운영에서는 32자 이상이어야 하고, 예시 기본값이면 부팅이 막힌다
JWT_SECRET=change-me-in-production

# 쉼표로 나열한다. 운영에서 localhost 가 남아 있으면 부팅이 막힌다
CORS_ORIGINS=http://localhost:5173
# **프록시 뒤에 있을 때만 X-Forwarded-For 를 믿는다.** 비우면 헤더를 아예 안 본다 —
# 비워 두는 것이 안전한 기본값이다 (위조로 레이트리밋을 우회하지 못하게)
TRUSTED_PROXY_CIDRS=

# --- 오브젝트 스토리지 -----------------------------------------------------
STORAGE_BUCKET=resona-local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
# 운영에서 비면 부팅이 막힌다 — 더미 키로 서명해 업로드가 조용히 실패하는 것을 방지
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- 메일 (Gmail SMTP) -----------------------------------------------------
# **앱 비밀번호를 쓴다.** 계정 비밀번호는 동작하지 않는다 —
# 구글 계정 → 보안 → 2단계 인증(필수) → 앱 비밀번호에서 16자리를 발급받는다.
# 비어 있으면 메일은 큐에 그대로 쌓이고 발송만 안 된다 (로컬 개발용 동작).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=RESONA
# 메일 안의 링크가 가리킬 주소. 운영에서 https 가 아니면 부팅이 막힌다
APP_BASE_URL=http://localhost:5173

# --- 결제 웹훅 -------------------------------------------------------------
# 비면 **로컬에서만** 서명 검증을 건너뛴다. 운영에서는 부팅이 막힌다 —
# 웹훅 URL 은 공개 주소라, 검증이 없으면 누구나 자기 조직을 Pro 로 만들 수 있다
BILLING_WEBHOOK_SECRET=

# --- 구글 로그인 -----------------------------------------------------------
# 구글 클라우드 콘솔 → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID
# (웹 애플리케이션). 승인된 리디렉션 URI 에 아래 값을 그대로 넣는다.
# 비어 있으면 구글 로그인만 동작하지 않고 나머지는 그대로 돈다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback

# --- 첫 플랫폼 운영자 -------------------------------------------------------
# 이 주소로 **새로 가입**하면 platform_role='owner' 가 된다. 비워 두면 어드민
# API 전체가 아무도 못 쓰는 상태로 뜬다 (권한 부여가 owner 를 요구하는데 owner 가
# 생기지 않는다). 이미 있는 계정은 승격되지 않는다 — 그건 권한 상승 경로가 된다.
BOOTSTRAP_OWNER_EMAIL=
